# Environment — never commit a real one. .env.example is the contract; .env holds secrets.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local certificate bundles (corporate TLS interception) — machine-specific
*-ca-bundle.pem
