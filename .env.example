# Rua configuration.
#
#   cp .env.example .env
#
# This file is the contract between a deployment and rua/config.py. Every variable
# here has a matching field there; adding one means adding it in both places.
#
# Microsoft Graph credentials are deliberately NOT here. They are entered in the
# first-run wizard and stored encrypted with SECRET_KEY, and are never redisplayed.


# ─── Required ────────────────────────────────────────────────────────────────

# Password for the bundled PostgreSQL container. Read by docker-compose.yml only;
# the application itself does not use it. It must match the password embedded in
# DATABASE_URL below — Compose does not interpolate one env var into another.
POSTGRES_PASSWORD=

# SQLAlchemy URL. The psycopg (v3) driver is required.
# Host `postgres` is the Compose service name; use `localhost` when running the
# app outside Compose against a published port.
DATABASE_URL=postgresql+psycopg://rua:CHANGE_ME@postgres:5432/rua

# Encrypts the stored Graph client secret at rest, and signs session cookies.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates the stored Graph credentials and every session; you
# will have to re-enter the client secret in Settings.
SECRET_KEY=


# ─── Optional ────────────────────────────────────────────────────────────────

# External URL of this deployment. Used for links generated in alerts and for
# the redirect URI shown in the setup wizard. No trailing slash.
BASE_URL=http://localhost:8080

# How often the report mailbox is polled, in minutes.
INGEST_INTERVAL_MINUTES=60

# UTC hour (0-23) for the daily Graph /domains sync and DNS re-check.
DOMAIN_SYNC_HOUR=3

# Raw per-source report rows are kept this many days, then rolled up to daily
# per-domain aggregates. Aggregate reports contain sending IP addresses, which
# may be personal data in your jurisdiction — set this to your policy, not ours.
RETENTION_RAW_DAYS=90

# Daily aggregates are kept this many days, then deleted.
# Must be greater than or equal to RETENTION_RAW_DAYS.
RETENTION_ROLLUP_DAYS=730

# Teams or Slack incoming webhook. Posted to on a newly-detected gap and on
# ingestion failure. Leave unset for no alerting — Rua makes no outbound call
# the operator has not configured.
ALERT_WEBHOOK_URL=

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Structured JSON to stdout.
LOG_LEVEL=INFO
