# Normalise to LF in the repository. Windows checkouts may use CRLF locally, but
# these files are read by Linux tooling inside the container, where a CR breaks
# shell parsing and shebangs in ways that are tedious to diagnose.

* text=auto eol=lf

Dockerfile      text eol=lf
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.mako          text eol=lf
.env.example    text eol=lf

# Fixtures are byte-exact: `-text` keeps git from normalising line endings, which
# would change what the parser actually sees. `-diff` is deliberately NOT set —
# a redacted report is the most useful thing in a review, and marking it binary
# would hide it.
tests/fixtures/**   -text
*.gz            binary
*.zip           binary
